import rclpy
from rclpy.node import Node
from custom_interfaces.msg import RobotStatus

class Subscriber(Node):
    def __init__(self):
        super().__init__('ai_subscriber')
        self.subscription = self.create_subscription(RobotStatus, '/telemetry', self.subscription_callback, 10)

    def subscription_callback(self, msg):
        battery = msg.battery
        if (battery <= 20):
            self.get_logger().info('ATENÇÃO: Nível da bateria está baixo. ("%i"%)' % (battery))

def main(args=None):
    rclpy.init(args=args)
    subscriber = Subscriber()
    rclpy.spin(subscriber)
    subscriber.destroy_node()
    rclpy.shutdown()
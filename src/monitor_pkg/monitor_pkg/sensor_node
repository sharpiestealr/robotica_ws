import rclpy
from rclpy.node import Node
from custom_interfaces.msg import RobotStatus
from custom_interfaces.srv import SetLimit

class Publisher(Node):
    def __init__(self):
        super().__init__('ai_publisher')
        self.publisher = self.create_publisher(RobotStatus, '/telemetry', 10)
        self.timer = self.create_timer(1.0, self.timer_callback)
        self.contador = 0
        self.srv_server = self.create_service(SetLimit, '/set_battery_limit', self.srv_callback)

    def srv_callback(self, request, response):
        min_battery = request.min_battery
        response.success = False
        if (min_battery == request.min_battery): response.success = True
        return response

    def timer_callback(self):
        self.contador += 1
        msg = RobotStatus()
        msg.count = self.contador
        msg.battery = 100-msg.count
        self.publisher.publish(msg)
        self.get_logger().info('Bateria: "%i"' % (msg.battery))

def main(args=None):
    rclpy.init(args=args)
    publisher = Publisher()
    rclpy.spin(publisher)
    publisher.destroy_node()
    rclpy.shutdown()